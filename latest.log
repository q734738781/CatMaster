rgy minimisation' not in txt:\n        # if iteration count equals NSW often indicates exhaustion\n        # parse NSW\n        nswm=re.findall(r'\\bNSW\\s*=\\s*(\\d+)',txt)\n        NSW=int(nswm[-1]) if nswm else None\n        if NSW is not None:\n            # find ionic steps count from \"----- Iteration\" lines e.g. 1(  1)\n            its=re.findall(r'-+\\s*Iteration\\s*\\d+\\(\\s*(\\d+)\\)',txt)\n            if its:\n                last_ionic=max(int(x) for x in its)\n                if last_ionic>=NSW:\n                    res['nsw_exhausted']=True\n\n    # max force from last TOTAL-FORCE block\n    # capture last block after header \"TOTAL-FORCE (eV/Angst)\"\n    blocks=list(re.finditer(r'TOTAL-FORCE \\(eV/Angst\\)[\\s\\S]*?\\n\\s*-+\\n([\\s\\S]*?)(?:\\n\\s*-{10,}|\\n\\s*total drift:)',txt))\n    if blocks:\n        b=blocks[-1].group(1)\n        maxf=0.0\n        for line in b.splitlines():\n            cols=line.split()\n            if len(cols)>=6:\n                try:\n                    fx,fy,fz=map(float,cols[3:6])\n                except Exception:\n                    continue\n                f=(fx*fx+fy*fy+fz*fz)**0.5\n                if f>maxf: maxf=f\n        if maxf>0:\n            res['max_force_eVA']=maxf\n\nif res['ediffg'] is not None and res['max_force_eVA'] is not None:\n    thr=abs(res['ediffg'])\n    res['ediffg_met']=res['max_force_eVA']<=thr+1e-8\n\n# electronic convergence for final ionic step from OSZICAR: final line for ionic step has dE and rms below EDIFF maybe difficult.\n# heuristic: last electronic iteration line in OSZICAR exists and run finished normally with no DAV failure.\nif os.path.exists(osz):\n    ot=open(osz,'r',errors='ignore').read().strip().splitlines()\n    # get last ionic summary line containing F=\n    ionic=[l for l in ot if ' F=' in l and 'E0=' in l]\n    if ionic:\n        res['electronic_converged_final_ionic']=True\n\nprint(json.dumps(res,indent=2))\nPY", "cwd": ".", "timeout_s": 120, "no_network": true