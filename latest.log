,"items":{"type":"string"},"title":"Updated Work Packages","type":"array"},"change_log":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Short change summary (1-3 concise points). Use null when not applicable.","title":"Change Log"},"needs_human":{"description":"Whether human approval or clarification is required.","title":"Needs Human","type":"boolean"},"questions_for_human":{"description":"Short question strings for human decisions. Use [] when no questions remain.","items":{"type":"string"},"title":"Questions For Human","type":"array"}},"required":["updated_proposal_md","updated_work_packages","change_log","needs_human","questions_for_human"],"title":"ReviseProposalPayload","type":"object"},{"type":"null"}],"description":"Payload for MajorReviseProposal branch (must be non-null only when state=MajorReviseProposal)."},"stop_and_synthesize":{"anyOf":[{"additionalProperties":false,"properties":{"final_answer_md":{"description":"Concise final user-facing answer markdown. Include final requested values with units and project-relative evidence paths; avoid long narrative report sections.","title":"Final Answer Md","type":"string"}},"required":["final_answer_md"],"title":"StopAndSynthesizePayload","type":"object"},{"type":"null"}],"description":"Payload for StopAndSynthesize branch (must be non-null only when state=StopAndSynthesize)."},"update_memory":{"description":"Memory updates to persist at run end. Use [] when no durable scientific invariant/result/constraint changed.","items":{"additionalProperties":false,"description":"Requested durable memory update item emitted by director.","properties":{"topic":{"description":"Target memory file to update. Topic semantics: GOAL=objective/scope/success criteria; FACTS=verified scientific facts/results only; FILES=artifact path index and file roles; CONSTRAINTS=hard limits/policies; QUESTIONS=unresolved questions; RUNBOOK=reusable procedural checklist; MEMORY.md=index-level concise summary/pointers.","enum":["MEMOR