","type":"array"}},"required":["goal","task_detail","expected_outputs","suggested_tools","reference_hint"],"title":"TaskPacket","type":"object"}},"required":["task_packet"],"title":"PerformNextTaskPayload","type":"object"},{"type":"null"}],"description":"Payload for PerformNextTask branch (must be non-null only when state=PerformNextTask)."},"minor_revise_proposal":{"anyOf":[{"additionalProperties":false,"properties":{"updated_proposal_md":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Updated proposal markdown body; use null when markdown body text does not need changes.","title":"Updated Proposal Md"},"updated_work_packages":{"description":"Updated ordered work packages. Use [] when no work-package updates are needed.","items":{"type":"string"},"title":"Updated Work Packages","type":"array"},"change_log":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Short change summary (1-3 concise points). Use null when not applicable.","title":"Change Log"},"needs_human":{"description":"Whether human approval or clarification is required.","title":"Needs Human","type":"boolean"},"questions_for_human":{"description":"Short question strings for human decisions. Use [] when no questions remain.","items":{"type":"string"},"title":"Questions For Human","type":"array"}},"required":["updated_proposal_md","updated_work_packages","change_log","needs_human","questions_for_human"],"title":"ReviseProposalPayload","type":"object"},{"type":"null"}],"description":"Payload for MinorReviseProposal branch (must be non-null only when state=MinorReviseProposal)."},"major_revise_proposal":{"anyOf":[{"additionalProperties":false,"properties":{"updated_proposal_md":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Updated proposal markdown body; use null when markdown body text does not need changes.","title":"Updated Proposal Md"},"updated_work_packages":{"description":"Updated ordered work packages. Use [] when no work-package updates are needed.","items":{"type