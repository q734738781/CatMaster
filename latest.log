AR/CONTCAR/.vasp/.cif).","type":"string"},"final_path":{"description":"Final structure file (POSCAR/CONTCAR/.vasp/.cif).","type":"string"},"n_images":{"description":"Number of intermediate images (NI).","minimum":1,"type":"integer"},"output_dir":{"default":"neb_images","description":"Output directory for image folders (workspace-relative).","type":"string"},"output_filename":{"default":"POSCAR","description":"Filename for each image output (e.g., POSCAR).","type":"string"},"interp_mode":{"default":"direct","description":"Output coordinate style when writing POSCAR: direct (fractional) or cartesian.","pattern":"^(direct|cartesian)$","type":"string"},"interp_method":{"default":"linear","description":"Interpolation method: linear or idpp.","pattern":"^(linear|idpp)$","type":"string"},"vtst_wrap":{"default":true,"description":"If true, wrap fractional coordinates into [0,1) before interpolation (VTST nebmake.pl behavior).","type":"boolean"},"overwrite":{"default":false,"description":"If true, overwrite output_dir if it exists.","type":"boolean"}},"required":["initial_path","final_path","n_images"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"make_neb_incar","description":"Generate a VTST NEB/CI-NEB INCAR based on a template INCAR.\n\n    The tool parses the template INCAR (ignores comments/blank lines, case-insensitive keys),\n    applies NEB overrides, and writes the final INCAR along with a patch JSON.","parameters":{"properties":{"template_incar_path":{"description":"Template INCAR path (workspace-relative).","type":"string"},"output_incar_path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output INCAR path. If omitted, uses output_dir/INCAR."},"output_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":"neb_inputs","description":"Output directory for INCAR and patch JSON (workspace-relative)."},"images":{"description":"Number of intermediate images (IMAGES).","minimum":1,"type":"integer"},"climb":{"default":false,"description":"Enable CI-NEB with LCLIMB=.TRUE. if true.","type":"boolean"},"iopt":{"default":7,"description":"IOPT value for VTST optimizer (allowed: 7/2/1).","type":"integer"},"ediff":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"Override EDIFF if provided."},"ediffg":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"Override EDIFFG if provided."},"spring":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"Override SPRING if provided."},"potim":{"anyOf":[{"type":"number"},{"type":"null"}],"default":0.0,"description":"Override POTIM (default 0)."},"additional_overrides":{"additionalProperties":true,"description":"Additional INCAR overrides as a dict; highest priority and can override required defaults. In this tool, due to pymatgen constraints, MAGMOM/LDAUU/LDAUJ must be provided as symbol:value maps. If not provided, no user override is applied and this tool's default INCAR strategy is used. Use null value to remove a key from INCAR.","type":"object"}},"required":["template_incar_path","images"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"vasp_execute_batch","description":"Submit VASP runs in one DPDispatcher submission (single-folder or recursive batch modes).","parameters":{"properties":{"input_dir":{"description":"Input directory for VASP execution. Two modes are supported: (1) single-folder mode: input_dir itself is a VASP calc folder containing INCAR and POTCAR; (2) batch mode: recursively discover subfolders containing INCAR and POTCAR. Nested mode is forbidden when input_dir itself is a calc folder and descendants also contain calc folders.","type":"string"},"output_dir":{"description":"Root directory to store outputs. In single-folder mode, results go to output_dir/<basename(input_dir)>. In batch mode, results mirror discovered subfolder layout under output_dir. Must not be inside input_dir. Staging directories