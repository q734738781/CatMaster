with the workspace-relative path to this JSON file.","parameters":{"properties":{"slab_file":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Slab structure file (POSCAR/CONTCAR/CIF)."},"slab_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Directory containing slab files for high-throughput placement."},"adsorbate_file":{"description":"Adsorbate molecule file (XYZ).","type":"string"},"mode":{"default":"all","description":"all|ontop|bridge|hollow","type":"string"},"distance":{"default":2.0,"description":"Height used to generate adsorption sites (Å).","minimum":0.0,"type":"number"},"max_structures":{"default":1000,"description":"Maximum number of adsorbed structures to generate.","minimum":1,"type":"integer"},"output_dir":{"default":"adsorption/batch","description":"Directory to write batch POSCARs.","type":"string"}},"required":["adsorbate_file"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"read_text_file","description":"Read the complete contents of a file from the file system as text. Handles various text encodings and provides detailed error messages if the file cannot be read. Use this tool when you need to examine the contents of a single file. Use the 'head' parameter to read only the first N lines of a file, or the 'tail' parameter to read only the last N lines of a file. Operates on the file as text regardless of extension. Only works within allowed directories.","parameters":{"$schema":"http://json-schema.org/draft-07/schema#","type":"object","properties":{"path":{"type":"string"},"tail":{"description":"If provided, returns only the last N lines of the file","type":"number"},"head":{"description":"If provided, returns only the first N lines of the file","type":"number"}},"required":["path"]}}},{"type":"function","function":{"name":"read_multiple_files","description":"Read the contents of multiple files simultaneously. This is more efficient than reading files 