or clarification is required.","title":"Needs Human","type":"boolean"},"questions_for_human":{"description":"Short question strings for human decisions. Use [] when no questions remain.","items":{"type":"string"},"title":"Questions For Human","type":"array"}},"required":["updated_proposal_md","updated_work_packages","change_log","needs_human","questions_for_human"],"title":"ReviseProposalPayload","type":"object"},{"type":"null"}],"description":"Payload for MinorReviseProposal branch (must be non-null only when state=MinorReviseProposal)."},"major_revise_proposal":{"anyOf":[{"additionalProperties":false,"properties":{"updated_proposal_md":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Updated proposal markdown body; use null when markdown body text does not need changes.","title":"Updated Proposal Md"},"updated_work_packages":{"description":"Updated ordered work packages. Use [] when no work-package updates are needed.","items":{"type":"string"},"title":"Updated Work Packages","type":"array"},"change_log":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Short change summary (1-3 concise points). Use null when not applicable.","title":"Change Log"},"needs_human":{"description":"Whether human approval or clarification is required.","title":"Needs Human","type":"boolean"},"questions_for_human":{"description":"Short question strings for human decisions. Use [] when no questions remain.","items":{"type":"string"},"title":"Questions For Human","type":"array"}},"required":["updated_proposal_md","updated_work_packages","change_log","needs_human","questions_for_human"],"title":"ReviseProposalPayload","type":"object"},{"type":"null"}],"description":"Payload for MajorReviseProposal branch (must be non-null only when state=MajorReviseProposal)."},"stop_and_synthesize":{"anyOf":[{"additionalProperties":false,"properties":{"stop_reason":{"anyOf":[{"type":"string"},{"type":"null"}],"description":"Short stop reason. Use null only when no additional stop reaso