l = {}\\nfor item in batch_summary.get('results', []):\\n    label = Path(item['input_rel']).stem\\n    results_by_label[label] = item\\n\\nall_labels = ['ontop_0', 'bridge_0', 'bridge_1', 'hollow_0']\\nrows = []\\nfor label in all_labels:\\n    meta = meta_by_label.get(label, {})\\n    item = results_by_label.get(label)\\n    summary = item.get('summary', {}) if item else {}\\n    converged = bool(summary.get('converged', False)) if item else False\\n    has_energy = 'final_energy_eV' in summary\\n    status = 'converged' if (item and converged and has_energy) else ('unconverged' if item else 'missing')\\n    final_e = summary.get('final_energy_eV') if has_energy else None\\n    e_ads = (final_e - slab_e - co_e) if final_e is not None else None\\n    row = {\\n        'label': label,\\n        'site_label': label,\\n        'status': status,\\n        'converged': converged if item else False,\\n        'final_adsorbed_energy_eV': final_e,\\n        'E_ads_eV': e_ads,\\n        'rank_success': None,\\n        'nsteps': summary.get('nsteps') if item else None,\\n        'max_force_eV_per_A': summary.get('max_force') if item else None,\\n        'relaxed_structure_path': f\\\"mace_runs/ads_relax_fe110_co/{item['output_rel']}/{summary.get('output_structure','opt.vasp')}\\\" if item else None,\\n        'summary_path': f\\\"mace_runs/ads_relax_fe110_co/{item['output_rel']}/summary.json\\\" if item else None,\\n        'input_structure_path': meta.get('output_poscar_rel'),\\n        'metadata_path': meta.get('metadata_rel'),\\n        'ads_indices': meta.get('ads_indices'),\\n        'slab_id': meta.get('slab_id'),\\n        'reference_slab_energy_eV': slab_e,\\n        'reference_slab_summary_path': str(ref_slab_path.relative_to(root)),\\n        'reference_co_energy_eV': co_e,\\n        'reference_co_summary_path': str(ref_co_path.relative_to(root)),\\n        'batch_summary_path': str(batch_summary_path.relative_to(root)),\\n        'batch_state_path': str(batch_state_path.relative_to(root)),\\n        'energy_convention': 'E_ads = E(slab+CO) - E(clean slab) - E(CO_gas)'\\n    }\\n    rows.append(row)\\n\\nsuccessful = [r for r in rows if r['status'] == 'converged' and r['E_ads_eV'] is not None]\\nsuccessful_sorted = sorted(successful, key=lambda r: (r['E_ads_eV'], r['label']))\\nfor i, r in enumerate(successful_sorted, start=1):\\n    r['rank_success'] = i\\n\\nrows_sorted = sorted(rows, key=lambda r: (r['rank_success'] is None, r['rank_success'] if r['rank_success'] is not None else 999, r['label']))\\n\\njson_payload = {\\n    'system': 'CO on Fe(110)',\\n    'batch_input_dir': 'adsorption/fe110_co/batch',\\n    'batch_output_root': 'mace_runs/ads_relax_fe110_co',\\n    'workflow_settings': {\\n        'model': batch_summary.get('model'),\\n        'head': batch_summary.get('head'),\\n        'dispersion': batch_summary.get('dispersion'),\\n        'relax_lattice': batch_summary.get('relax_lattice'),\\n        'fmax': batch_summary.get('fmax'),\\n        'maxsteps': batch_summary.get('steps')\\n    },\\n    'reference_energies': {\\n        'clean_slab_final_energy_eV': slab_e,\\n        'clean_slab_summary_path': str(ref_slab_path.relative_to(root)),\\n        'co_gas_final_energy_eV': co_e,\\n        'co_gas_summary_path': str(ref_co_path.relative_to(root))\\n    },\\n    'energy_convention': 'E_ads = E(slab+CO) - E(clean slab) - E(CO_gas)',\\n    'batch_state': batch_state,\\n    'candidates': rows_sorted\\n}\\n\\njson_path = reports / 'fe110_co_adsorption_ranking.json'\\njson_path.write_text(json.dumps(json_payload, indent=2) + '\\\\n')\\n\\ncsv_path = reports / 'fe110_co_adsorption_ranking.csv'\\nfieldnames = [\\n    'rank_success', 'site_label', 'status', 'converged', 'final_adsorbed_energy_eV',\\n    'E_ads_eV', 'nsteps', 'max_force_eV_per_A', 'relaxed_structure_path', 'summary_path',\\n    'input_structure_path', 'metadata_path', 'reference_slab_energy_eV',\\n    'reference_slab_summary_path', 'reference_co_energy_eV