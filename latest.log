ean"},"hint":{"description":"Optional concise recovery hint for status=blocked. For status=done, use empty string ''.","type":"string"}},"required":["status","summary","facts","files","constraints","open_questions","decisions","next_steps","artifacts","error","needs_human","hint"],"type":"object"}}}],"prompt_cache_retention":"24h"}
