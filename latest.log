on":"Materials Project IDs, e.g., ['mp-149', 'mp-13'].","items":{"type":"string"},"type":"array"},"fmt":{"default":"poscar","description":"Output format: poscar|cif|json.","pattern":"^(poscar|cif|json)$","type":"string"},"output_dir":{"default":"retrieval/mp","description":"Workspace-relative directory to save the structure.","type":"string"}},"required":["mp_ids"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"bash_exec","description":"Execute a multi-line bash script inside the workspace (default) and return stdout/stderr.\n    Network access is disabled by default using Linux network namespaces (unshare).\n    Symbolic link operations are disabled; use copy/move operations instead.\n    Stdout/stderr are returned as-is and projection/offload is handled centrally.\n    When stdout/stderr are over the offload threshold (600 chars), the tool observation includes\n    an explicit archived-log hint path so downstream steps can inspect full logs if needed.\n    Keep output short in scripts and print one-line summaries when possible.","parameters":{"properties":{"script":{"description":"Bash script to execute (multi-line).","type":"string"},"cwd":{"default":".","description":"Working directory inside project files root.","type":"string"},"timeout_s":{"default":86400.0,"description":"Timeout seconds.","minimum":0.1,"type":"number"},"no_network":{"default":true,"description":"Disable network using unshare network namespace.","type":"boolean"}},"required":["script"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"TaskOutput","description":"Structured output from the task runner agent.","parameters":{"additionalProperties":false,"properties":{"status":{"description":"Task terminal status. Use 'done' only when task acceptance criteria are satisfied; use 'blocked' when progress is blocked by unresolved issues.","enum":["done","blocked"],"type":"string"},"summary":{"description":"Concise task outcom