ath.dirname(json_out), exist_ok=True)\\nwith open(json_out, \\\"w\\\") as f:\\n    json.dump(summary, f, indent=2)\\n\\nwith open(txt_out, \\\"w\\\") as f:\\n    f.write(f\\\"final_TOTEN_eV: {summary['toten_eV']:.10f}\\\\n\\\")\\n    f.write(f\\\"energy_per_atom_eV: {summary['energy_per_atom_eV']:.10f}\\\\n\\\")\\n    f.write(f\\\"O-O_bond_length_A: {summary['oo_bond_A']:.10f}\\\\n\\\")\\n    f.write(f\\\"OUTCAR_provenance: line {line_no}: {line_text}\\\\n\\\")\\n    if \\\"oszicar_last_F_eV\\\" in summary:\\n        f.write(f\\\"OSZICAR_last_F_eV: {summary['oszicar_last_F_eV']:.10f}\\\\n\\\")\\n        f.write(f\\\"TOTEN_minus_OSZICAR_F_eV: {summary['toten_minus_oszicarF_eV']:.10e}\\\\n\\\")\\n\\nprint(f\\\"final TOTEN (eV): {summary['toten_eV']:.10f}\\\")\\nprint(f\\\"energy per atom (eV/atom): {summary['energy_per_atom_eV']:.10f}\\\")\\nprint(f\\\"O–O bond length (Å): {summary['oo_bond_A']:.10f}\\\")\\nprint(f\\\"OUTCAR provenance: line {line_no}: {line_text}\\\")\\nif \\\"oszicar_last_F_eV\\\" in summary:\\n    print(f\\\"OSZICAR last F (eV): {summary['oszicar_last_F_eV']:.10f}\\\")\\n    print(f\\\"TOTEN-OSZICAR_F (eV): {summary['toten_minus_oszicarF_eV']:.3e}\\\")\\nPY\\n\", \"cwd\": \".\", \"timeout_s\": 120, \"no_network\": true}"}}]},{"content":"Bash exited with code 1\ncwd=. timeout_s=120.0\nstderr:\nTraceback (most recent call last):\n  File \"<stdin>\", line 8, in <module>\n  File \"<frozen os>\", line 714, in __getitem__\nKeyError: 'TOTEN'\n\nstdout:","role":"tool","tool_call_id":"call_rIRtjE3X0pMEwJqbuLm02s2d"}],"model":"openai/gpt-5.3-codex:online","reasoning_effort":"medium","stream":false,"temperature":1.0,"tool_choice":"required","tools":[{"type":"function","function":{"name":"create_molecule_from_smiles","description":"Build a 3D molecule from a SMILES string using RDKit. Specially, pay attention to the formal charge of the SMILES string, RDkit will check the charge and add Hs to the molecule to make it neutral.","parameters":{"properties":{"smiles":{"description":"SMILES string for the molecule.","type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Optional base name for output files; defaults to formula."},"output_path":{"default":"mol","description":"Workspace-relative path prefix; files will be <prefix>.xyz and/or <prefix>.vasp.","type":"string"},"box_padding":{"default":10.0,"description":"Padding (Å) added around the molecule to make a cubic box for POSCAR. Box lattice is around twice the padding value (10A Padding -> 20A Box).","minimum":0.0,"type":"number"},"fmt":{"default":"poscar","description":"Output format: poscar (with PBC box), xyz (no PBC), or both.","pattern":"^(poscar|xyz|both)$","type":"string"}},"required":["smiles"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"mace_relax_batch","description":"Submit multiple MACE relaxations in one DPDispatcher submission. Preferred tool for batch MACE relaxations.","parameters":{"properties":{"input_dir":{"description":"Root directory containing structure files with lattice (POSCAR/CIF).","type":"string"},"output_root":{"description":"Root directory to store batch outputs. Results mirror the input directory structure; each input file expands to a folder without suffix (e.g. input_dir/a/c.vasp -> output_root/a/c/opt.vasp). Must be outside input_dir.","type":"string"},"fmax":{"default":0.02,"description":"Force threshold for relaxation in eV/Angstrom.","exclusiveMinimum":0,"type":"number"},"maxsteps":{"default":500,"description":"Max steps for relaxation.","minimum":1,"type":"integer"},"model":{"default":"mh-1","description":"MACE model name. Recommended options: 'mh-1' (slower, higher accuracy) or 'medium-mpa-0' (faster, lower accuracy).","examples":["mh-1","medium-mpa-0"],"type":"string"},"head":{"anyOf":[{"type":"string"},{"type":"null"}],"default":"omat_pbe","description":"Model head for multi-head models (e.g. 'omat_pbe'). Use empty string to disable."},"dispersion":{"default":false,"description":"Enable dispersion correction in mace_mp. Default: false.","type":"boolean"},"relax_lattice":{"default":false,"description":"Whether to relax lattice/cell together with atomic positions via ASE FrechetCellFilter.","type":"boolean"},"check_interval":{"default":30,"description":"Polling interval in seconds when waiting.","type":"integer"}},"required":["input_dir","output_root"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"mace_sp_batch","description":"Run MACE single-point jobs for structures under one directory.","parameters":{"properties":{"input_dir":{"description":"Input directory containing structures (POSCAR/CONTCAR/CIF/VASP).","type":"string"},"output_root":{"description":"Output root for batch results. Must be outside input_dir.","type":"string"},"model":{"default":"mh-1","description":"MACE model name (e.g., mh-1, medium-mpa-0).","examples":["mh-1","medium-mpa-0"],"type":"string"},"head":{"anyOf":[{"type":"string"},{"type":"null"}],"default":"omat_pbe","description":"Model head for multi-head models. Use empty string to disable."},"dispersion":{"default":false,"description":"Enable dispersion correction.","type":"boolean"},"check_interval":{"default":30,"description":"Polling interval in seconds when waiting.","type":"integer"}},"required":["input_dir","output_root"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"vasp_relax_prepare","description":"Prepare MPRelaxSet-based VASP relax inputs with calc_type presets and k_product k-mesh.\n    Also can be modified for other calculation types by overriding INCAR via the user_incar_settings.\n    Support exts: .vasp, .cif\n\n    Baseline DFT settings follow Materials Project MPRelaxSet (key defaults):\n    - PBE54 POTCARS, ENCUT=520 eV, PREC=Accurate, ISPIN=2, IBRION=2, LREAL=AUTO, LASPH=True, LWAVE=False, LCHARG=False.\n    - Additional overrides applied based on calc_type: ISMEAR=0, SIGMA=0.1 for bulk/slab; ISMEAR=0, SIGMA=0.01 for gas.\n    - ISIF policy: bulk with relax_cell=False -> ISIF=2; bulk with relax_cell=True -> ISIF=3.\n      slab and gas always use ISIF=2, where slab forces KPOINTS z=1 and gas forces KPOINTS 1x1x1 with ISYM=0, LREAL=False.\n    - Improved convergence settings: EDIFF=1e-6; NSW=500; EDIFFG=-0.02;\n    - LORBIT is controlled by compute_dos (default False -> LORBIT=0, True -> LORBIT=11).\n    - KPOINTS is generated by k*a=k_product, where a is the lattice constant in Angstrom. Set to 30 by default and sufficient for most systems.\n    - DFT-D3 and DFT+U are disabled by default. Enable them if the system is adsorption system(DFT-D3) or transition metal oxide system(DFT+U).","parameters":{"properties":{"input_path":{"description":"Path to a structure file with lattice information (POSCAR/CIF) or a directory containing multiple structures. Support exts: .vasp, .cif","type":"string"},"output_root":{"description":"Root directory for generated VASP inputs (one subfolder per input structure). If input_path is a file: output_root/<stem>/...; if input_path is a directory, preserve relative subfolders: output_root/<relpath>/<stem>/...","type":"string"},"calc_type":{"default":"bulk","description":"Calculation type: 'gas'|'bulk'|'slab'. This provides preset INCAR overrides for different calculation types. gas is suitable for small molecules; slab is suitable for surface slab models; bulk is suitable for bulk relaxations.","enum":["gas","bulk","slab"],"type":"string"},"relax_cell":{"default":false,"description":"Whether to relax cell shape/volume (ISIF=3). Only valid when calc_type='bulk'.","type":"boolean"},"k_product":{"default":30,"description":"Target k-mesh density via k_i~round(k_product/L_i), min 1, forced odd (Gamma-centered); gas always 1x1x1.","minimum":1,"type":"integer"},"use_d3":{"default":false,"description":"Enable DFT-D3 Correction (IVDW=11). Enable it for adsorption calculations.","type":"boolean"},"use_dft_plus_u":{"default":false,"description":"Enable DFT+U relevant settings according to materials project standard. Enable it for Transition Metal Oxide systems.","type":"boolean"},"compute_dos":{"default":false,"description":"Enable DOS/projection output by setting LORBIT=11. Default false (LORBIT=0) to reduce disk usage.","type":"boolean"},"enable_dipole":{"default":false,"description":"Enable dipole correction helper. When true, default IDIPOL=3 and set DIPOL to the atomic center of mass of cell in fractional coordinates.","type":"boolean"},"user_incar_settings":{"additionalProperties":true,"description":"User INCAR overrides as a json object as per pymatgen's user_incar_settings format, e.g. {\"MAGMOM\":{\"O\":1},\"ALGO\":\"Fast\"}. In this tool, due to pymatgen constraints, MAGMOM/LDAUU/LDAUJ must be provided as symbol:value maps. Use null only as a value inside the override object to remove a specific INCAR key, e.g. `{\"LREAL\": null}`. calc_type/task-required presets still take precedence on key conflict.","type":"object"}},"required":["input_path","output_root"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"vasp_sp_prepare","description":"Prepare MPRelaxSet-based VASP single-point inputs for structures under a file or directory. Parameters are the same as VaspRelaxPrepareInput, but with single_point relaxation enabled (NSW=0, IBRION=-1).","parameters":{"properties":{"input_path":{"description":"Structure file or directory of structures. Supported: .vasp, .cif","type":"string"},"output_root":{"description":"Root directory for generated VASP inputs (one subfolder per structure).","type":"string"},"calc_type":{"default":"bulk","description":"Calculation preset for k-mesh and INCAR defaults.","enum":["gas","bulk","slab"],"type":"string"},"k_product":{"default":30,"description":"k-mesh density via k_i~round(k_product/L_i), min 1.","minimum":1,"type":"integer"},"use_d3":{"default":false,"description":"Enable DFT-D3 correction (IVDW=11).","type":"boolean"},"use_dft_plus_u":{"default":false,"description":"Enable DFT+U settings.","type":"boolean"},"compute_dos":{"default":false,"description":"Enable DOS/projection output by setting LORBIT=11. Default false (LORBIT=0).","type":"boolean"},"enable_dipole":{"default":false,"description":"Enable dipole correction helper. When true, default IDIPOL=3 and set DIPOL to the atomic center of mass in fractional coordinates.","type":"boolean"},"user_incar_settings":{"additionalProperties":true,"description":"User INCAR overrides as a json object as per pymatgen's user_incar_settings format, e.g. {\"MAGMOM\":{\"O\":1},\"ALGO\":\"Fast\"}. In this tool, due to pymatgen constraints, MAGMOM/LDAUU/LDAUJ must be provided as symbol:value maps. Use null only as a value inside the override object to remove a specific INCAR key, e.g. `{\"LORBIT\": null}`. calc_type/task-required presets still take precedence on key conflict.","type":"object"}},"required":["input_path","output_root"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"build_slab","description":"Build slabs for all terminations of a Miller index from bulk structure(s).\n\n    Provide exactly one of bulk_structure or bulk_dir. When bulk_dir is used, output_root is required.\n    Batch outputs are written under output_root/<slab_id>/..., where slab_id encodes the relative input path\n    (without suffix) using '__'.","parameters":{"properties":{"bulk_structure":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Bulk structure file (POSCAR/CIF/etc.), workspace-relative."},"bulk_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Directory containing bulk structure files for batch slab building."},"miller_index":{"description":"Miller index [h,k,l].","items":{"type":"integer"},"maxItems":3,"minItems":3,"type":"array"},"output_root":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Directory to write the slab structures. Required for bulk_dir; defaults to 'slabs' for single file. For bulk_dir, outputs are written under output_root/<slab_id>/..., where slab_id encodes the relative input path (without suffix) using '__'."},"slab_thickness":{"default":12.0,"description":"Target slab thickness (Å).","minimum":0.0,"type":"number"},"vacuum_thickness":{"default":15.0,"description":"Vacuum thickness (Å).","minimum":0.0,"type":"number"},"supercell":{"default":[1,1,1],"description":"Supercell replication [a,b,c] for slab structure after generation.","items":{"type":"integer"},"maxItems":3,"minItems":3,"type":"array"},"get_symmetry_slab":{"default":false,"description":"If true, returned slabs will ensure top and bottom surfaces are identical. Use it for surface energy calculation.","type":"boolean"},"orthogonal":{"default":false,"description":"If true, convert each slab to an orthogonal c-oriented cell. Useful for grain boundary generation.","type":"boolean"},"lll_reduce":{"default":false,"description":"Apply LLL reduction during slab generation. Not recommended to use unless necessary.","type":"boolean"}},"required":["miller_index"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"fix_atoms_by_layers","description":"Fix (freeze) the bottom N atomic layers of slab structure(s).\n\n    Provide exactly one of structure_ref or structure_dir. When structure_dir is used, output_dir is required.\n    Batch outputs are written to output_dir/<slab_id>.vasp and a summary JSON is written to\n    output_dir/batch_fix_atoms_by_layers.json.","parameters":{"properties":{"structure_ref":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Slab structure file to modify (POSCAR/CIF)."},"structure_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Directory containing slab structure files to modify."},"output_path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output structure path (workspace-relative) for single file."},"output_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output directory for batch mode. Outputs are written as <output_dir>/<slab_id>.vasp where slab_id encodes the relative input path (without suffix) using '__'."},"freeze_layers":{"description":"Number of bottom layers to freeze. Use layer_tol to group layers.","minimum":0,"type":"integer"},"centralize":{"default":false,"description":"Recentre slab along c before applying constraints.","type":"boolean"},"layer_tol":{"default":0.2,"description":"Layer grouping tolerance in Å. 0.2 is suitable for most cases except for highly tilted slabs.","exclusiveMinimum":0.0,"type":"number"}},"required":["freeze_layers"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"fix_atoms_by_height","description":"Fix (freeze) atoms within specified z ranges of slab structure(s).\n\n    Provide exactly one of structure_ref or structure_dir. When structure_dir is used, output_dir is required.\n    Batch outputs are written to output_dir/<slab_id>.vasp and a summary JSON is written to\n    output_dir/batch_fix_atoms_by_height.json.","parameters":{"properties":{"structure_ref":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Slab structure file to modify (POSCAR/CIF)."},"structure_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Directory containing slab structure files to modify."},"output_path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output structure path (workspace-relative) for single file."},"output_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output directory for batch mode. Outputs are written as <output_dir>/<slab_id>.vasp where slab_id encodes the relative input path (without suffix) using '__'."},"z_ranges":{"description":"Ranges in Å in Cartesian coordinates; atoms in these z ranges are frozen.","items":{"properties":{"z_min":{"description":"Lower bound (Å) in Cartesian coordinates.","type":"number"},"z_max":{"description":"Upper bound (Å) in Cartesian coordinates.","type":"number"}},"required":["z_min","z_max"],"type":"object","additionalProperties":false},"minItems":1,"type":"array"},"centralize":{"default":false,"description":"Recentre slab along c after applying constraints.","type":"boolean"}},"required":["z_ranges"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"supercell","description":"Create supercells from structure file(s). THIS WILL LOSE ALL SELECTIVE DYNAMICS INFORMATION.\n    Provide exactly one of structure_file or structure_dir. When structure_dir is used, output_dir is required.\n    Batch outputs are written to output_dir/<structure_id>.vasp and a summary JSON is written to\n    output_dir/batch_supercell.json.\n\n    The JSON format is:\n    {\n      \"results\": [\n        {\"input_rel\": \"a/CO.vasp\", \"structure_id\": \"a__CO\", \"output_rel\": \"out/a__CO.vasp\", \"natoms\": 2}\n      ]\n    }","parameters":{"properties":{"structure_file":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Bulk structure file (POSCAR/CIF/etc.), workspace-relative."},"structure_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Directory containing structure files for batch supercell generation."},"supercell":{"description":"Supercell replication [a,b,c].","items":{"type":"integer"},"maxItems":3,"minItems":3,"type":"array"},"output_path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output structure path for single structure (workspace-relative, e.g., bulk_supercell.vasp)."},"output_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output directory for batch mode. Outputs are written as <output_dir>/<structure_id>.vasp where structure_id encodes the relative input path (without suffix) using '__'."}},"required":["supercell"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"enumerate_adsorption_sites","description":"Enumerate adsorption sites on a slab using ASF. Use it only for small scale placement.\n\n    The tool writes a JSON list to output_json:\n    [\n      {\"label\": \"ontop_0\", \"kind\": \"ontop\", \"cart_coords\": [x, y, z]}\n    ]\n    The returned tool data includes the workspace-relative path in \"sites\" and \"sites_json_rel\".","parameters":{"properties":{"slab_file":{"description":"Slab structure file (POSCAR/CONTCAR/CIF), workspace-relative.","type":"string"},"mode":{"default":"all","description":"Which site families to return: all|ontop|bridge|hollow.","type":"string"},"distance":{"default":2.0,"description":"Height above surface to sample adsorption sites (Å).","minimum":0.0,"type":"number"},"output_json":{"default":"adsorption/sites.json","description":"Output JSON path for site list (workspace-relative).","type":"string"}},"required":["slab_file"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"place_adsorbate","description":"Place an adsorbate molecule on a slab. Use it only if for small scale placement.\n    This tool keeps selective dynamics of the original slab structure and allows adsorbate to move freely.\n    It writes metadata sidecar <output>.meta.json and an ads_indices index JSON.","parameters":{"properties":{"slab_file":{"description":"Slab structure file (POSCAR/CONTCAR/CIF).","type":"string"},"adsorbate_file":{"description":"Adsorbate molecule file (XYZ).","type":"string"},"site":{"default":"auto","description":"Site label like ontop_0|bridge_1|hollow_2 or 'auto' (which use all[0]).","type":"string"},"distance":{"default":2.0,"description":"Height used to generate adsorption sites (Å).","minimum":0.0,"type":"number"},"output_poscar":{"default":"adsorption/adsorbed.vasp","description":"Output POSCAR path (workspace-relative).","type":"string"}},"required":["slab_file","adsorbate_file"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"generate_batch_adsorption_structures","description":"Generate multiple adsorbed structures up to max_structures. Suitable for large scale placement.\n    This tool keeps selective dynamics of the original slab structure and allows adsorbate to move freely.\n    Input can be a single slab file (slab_file) or a directory of slab files (slab_dir).\n    When slab_dir is used, each slab gets its own subdirectory under output_dir. Max_structures applies per slab.\n    For nested slab_dir layouts, slab_id encodes the relative path (without suffix) using '__'.\n\n    The tool writes a JSON list to output_dir/batch_structures.json and a per-structure\n    metadata sidecar <output>.meta.json with ads_indices.\n    It also writes output_dir/ads_indices.json as an index file:\n    [\n      {\n        \"slab_file_rel\": \"slabs/fe111.vasp\",\n        \"slab_id\": \"fe111\",\n        \"label\": \"ontop_0\",\n        \"output_poscar_rel\": \"adsorption/batch/fe111/ontop_0.vasp\",\n        \"ads_indices_added\": [36],\n        \"ads_indices\": [36]\n      }\n    ]\n    The returned tool data replaces \"structures\" with the workspace-relative path to this JSON file.","parameters":{"properties":{"slab_file":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Slab structure file (POSCAR/CONTCAR/CIF)."},"slab_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Directory containing slab files for high-throughput placement."},"adsorbate_file":{"description":"Adsorbate molecule file (XYZ).","type":"string"},"mode":{"default":"all","description":"all|ontop|bridge|hollow","type":"string"},"distance":{"default":2.0,"description":"Height used to generate adsorption sites (Å).","minimum":0.0,"type":"number"},"max_structures":{"default":1000,"description":"Maximum number of adsorbed structures to generate.","minimum":1,"type":"integer"},"output_dir":{"default":"adsorption/batch","description":"Directory to write batch POSCARs.","type":"string"}},"required":["adsorbate_file"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"make_neb_geometry","description":"Generate NEB interpolation geometries in nebmake.pl style.\n\n    The tool validates that initial and final structures have the same element order, atom count,\n    and lattice (within tolerance). Images are written under output_dir/00..(NI+1) with output_filename.\n    Selective dynamics constraints are preserved if present in the input files (ASE handles constraints).","parameters":{"properties":{"initial_path":{"description":"Initial structure file (POSCAR/CONTCAR/.vasp/.cif).","type":"string"},"final_path":{"description":"Final structure file (POSCAR/CONTCAR/.vasp/.cif).","type":"string"},"n_images":{"description":"Number of intermediate images (NI).","minimum":1,"type":"integer"},"output_dir":{"default":"neb_images","description":"Output directory for image folders (workspace-relative).","type":"string"},"output_filename":{"default":"POSCAR","description":"Filename for each image output (e.g., POSCAR).","type":"string"},"interp_mode":{"default":"direct","description":"Output coordinate style when writing POSCAR: direct (fractional) or cartesian.","pattern":"^(direct|cartesian)$","type":"string"},"interp_method":{"default":"linear","description":"Interpolation method: linear or idpp.","pattern":"^(linear|idpp)$","type":"string"},"vtst_wrap":{"default":true,"description":"If true, wrap fractional coordinates into [0,1) before interpolation (VTST nebmake.pl behavior).","type":"boolean"},"overwrite":{"default":false,"description":"If true, overwrite output_dir if it exists.","type":"boolean"}},"required":["initial_path","final_path","n_images"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"make_neb_incar","description":"Generate a VTST NEB/CI-NEB INCAR based on a template INCAR.\n\n    The tool parses the template INCAR (ignores comments/blank lines, case-insensitive keys),\n    applies NEB overrides, and writes the final INCAR along with a patch JSON.","parameters":{"properties":{"template_incar_path":{"description":"Template INCAR path (workspace-relative).","type":"string"},"output_incar_path":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Output INCAR path. If omitted, uses output_dir/INCAR."},"output_dir":{"anyOf":[{"type":"string"},{"type":"null"}],"default":"neb_inputs","description":"Output directory for INCAR and patch JSON (workspace-relative)."},"images":{"description":"Number of intermediate images (IMAGES).","minimum":1,"type":"integer"},"climb":{"default":false,"description":"Enable CI-NEB with LCLIMB=.TRUE. if true.","type":"boolean"},"iopt":{"default":7,"description":"IOPT value for VTST optimizer (allowed: 7/2/1).","type":"integer"},"ediff":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"Override EDIFF if provided."},"ediffg":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"Override EDIFFG if provided."},"spring":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"description":"Override SPRING if provided."},"potim":{"anyOf":[{"type":"number"},{"type":"null"}],"default":0.0,"description":"Override POTIM (default 0)."},"additional_overrides":{"additionalProperties":true,"description":"Additional INCAR overrides as a dict; highest priority and can override required defaults. In this tool, due to pymatgen constraints, MAGMOM/LDAUU/LDAUJ must be provided as symbol:value maps. If not provided, no user override is applied and this tool's default INCAR strategy is used. Use null value to remove a key from INCAR.","type":"object"}},"required":["template_incar_path","images"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"vasp_execute_batch","description":"Submit VASP runs in one DPDispatcher submission (single-folder or recursive batch modes).","parameters":{"properties":{"input_dir":{"description":"Input directory for VASP execution. Two modes are supported: (1) single-folder mode: input_dir itself is a VASP calc folder containing INCAR and POTCAR; (2) batch mode: recursively discover subfolders containing INCAR and POTCAR. Nested mode is forbidden when input_dir itself is a calc folder and descendants also contain calc folders.","type":"string"},"output_dir":{"description":"Root directory to store outputs. In single-folder mode, results go to output_dir/<basename(input_dir)>. In batch mode, results mirror discovered subfolder layout under output_dir. Must not be inside input_dir. Staging directories under output_dir are cleaned after completion.","type":"string"},"check_interval":{"default":30,"description":"Polling interval seconds","type":"integer"}},"required":["input_dir","output_dir"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"mp_search_materials","description":"Search Materials Project with flexible criteria and write results to CSV.\n\n    Common criteria keys (pass via `criteria`):\n      - material_ids (list[str] or str)\n      - elements (list[str] or str)\n      - chemsys (str)\n      - formula (str)\n      - is_stable (bool)\n      - energy_above_hull ([min, max])\n      - formation_energy ([min, max])\n      - band_gap ([min, max])\n      - crystal_system (str)\n      - spacegroup_number / spacegroup_symbol\n      - num_sites ([min, max])\n      - density ([min, max])\n      - volume ([min, max])\n      - num_elements ([min, max])\n    Common fields for output rows (pass via `fields`):\n      material_id, formula_pretty (or formula), energy_above_hull, formation_energy_per_atom (or formation_energy),\n      band_gap, crystal_system, spacegroup_number, spacegroup_symbol, nsites (or num_sites), density, volume.","parameters":{"properties":{"criteria":{"additionalProperties":true,"description":"Direct summary.search filters as a dict (keys listed above). Range values may be [min, max].","type":"object"},"fields":{"description":"Fields to include in CSV rows; supports common aliases.","items":{"type":"string"},"type":"array"},"limit":{"default":50,"description":"Maximum number of hits to return (default 50).","minimum":1,"type":"integer"},"output_csv":{"description":"Workspace-relative CSV path to write search results.","type":"string"}},"required":["output_csv"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"mp_download_structure","description":"Download one or more structures from Materials Project into the workspace.","parameters":{"properties":{"mp_ids":{"description":"Materials Project IDs, e.g., ['mp-149', 'mp-13'].","items":{"type":"string"},"type":"array"},"fmt":{"default":"poscar","description":"Output format: poscar|cif|json.","pattern":"^(poscar|cif|json)$","type":"string"},"output_dir":{"default":"retrieval/mp","description":"Workspace-relative directory to save the structure.","type":"string"}},"required":["mp_ids"],"type":"object","additionalProperties":false}}},{"type":"function","function":{"name":"bash_exec","description":"Execute a multi-line bash script inside the workspace (default) and return stdout/stderr.\n    Network access is disabled by default using Linux network namespaces (unshare).\n    Symbolic link operations are disabled; use copy/move operations instead.\n    Stdout/stderr are returned as-is and projection/offload is handled centrally.\n    Keep output short in scripts and print one-line summaries when possible.","parameters":{"properties":{"script":{"description":"Bash script to execute (multi-line).","type":"string"},"cwd":{"default":".","description":"Working directory inside project files root.","type":"string"},"timeout_s":{"default":86400.0,"description":"Timeout seconds.","minimum":0.1,"type":"number"},"no_network":{"default":true,"description":"Disable network using unshare net