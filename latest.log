ectory path when it is a clearer bundle-level reference. Avoid listing low-value scratch files. Use [] when none.","items":{"additionalProperties":false,"properties":{"path":{"description":"Workspace-relative artifact path (file or directory). Always use project-relative paths; do not use absolute paths.","type":"string"},"description":{"description":"Short one-line description.","type":"string"},"kind":{"description":"Artifact category. Common values: script, output, report, log. Use 'dir' when the path points to a directory bundle.","type":"string"}},"required":["path","description","kind"],"type":"object"},"type":"array"},"constraints":{"description":"Only new/changed constraints. Use [] when none.","items":{"type":"string"},"type":"array"},"open_questions":{"description":"Only unresolved blockers affecting next steps. Do not include speculative questions. Use [] when none.","items":{"type":"string"},"type":"array"},"decisions":{"description":"Only decisions materially affecting downstream work; avoid duplicating summary/facts content. Use [] when none.","items":{"additionalProperties":false,"properties":{"decision":{"description":"Short decision statement.","type":"string"},"rationale":{"description":"Brief rationale (one short sentence preferred).","type":"string"}},"required":["decision","rationale"],"type":"object"},"type":"array"},"next_steps":{"description":"Only immediate actionable next steps. Use [] when no next step is required.","items":{"type":"string"},"type":"array"},"artifacts":{"description":"Supporting artifact paths when needed. Use [] when none.","items":{"type":"string"},"type":"array"},"error":{"description":"Failure reason for status=blocked. For status=done, use empty string ''.","type":"string"},"needs_human":{"description":"Whether a human must intervene for status=blocked. For status=done, set false.","type":"boolean"},"hint":{"description":"Optional concise recovery hint for status=blocked. For status=done, use empty string ''.","type":