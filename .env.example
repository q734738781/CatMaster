# CatMaster environment variable checklist.
# The launcher does not auto-load this file. Use it as a reference, or copy to
# an ignored local file such as .env.local and source it manually.

# LLM config file selection. Default hardcoded path is configs/llm.yaml.
CATMASTER_LLM_CONFIG=configs/llm.yaml

# Optional single-model fallback when configs/llm.yaml is absent.
CATMASTER_LLM_PROVIDER=openrouter
CATMASTER_LLM_MODEL=openai/gpt-5.2
CATMASTER_API_KEY_ENV=OPENROUTER_API_KEY
CATMASTER_BASE_URL=
CATMASTER_TEMPERATURE=
CATMASTER_REASONING_EFFORT=

# Provider keys. Keep real values out of Git.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
MP_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
CORE_API_KEY=
NCBI_API_KEY=
UNPAYWALL_EMAIL=
ELSEVIER_API_KEY=
# Usually unnecessary; set only when your library explicitly provides one.
ELSEVIER_INSTTOKEN=

# Optional contact/proxy settings for lawful literature-source acquisition.
# CatMaster prefers direct OA routes, can use the official Elsevier API for
# authorized ScienceDirect access, and keeps ScanSci's headless publisher browser
# as an internal low-priority fallback; no agent-visible browser is exposed.
SCANSCI_PDF_PROXY=
CROSSREF_MAILTO=

# Optional external materials programs. Explicit paths take precedence over PATH.
CATMASTER_VASPKIT_BIN=
CATMASTER_VESTA_BIN=
CATMASTER_XVFB_RUN=
CATMASTER_PANDOC_BIN=
CATMASTER_CHROME_BIN=

# Optional OpenRouter metadata and endpoint overrides.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=CatMaster

# Optional runtime diagnostics for the single-model, no-YAML profile. In normal
# YAML mode, set the diagnostic flags in the selected configs/llm*.yaml file.
CATMASTER_PRINT_HTTP_RAW_POST=false
CATMASTER_TOOL_OUTPUT_CONFIG=configs/tool_output.yaml

# Self-evolution proposes and reviews in the background. Auto is the product
# default and selects eligible revisions for the next run; set observe when
# approved revisions should remain dormant.
# Trusted --no-login instances use the same lifecycle in the local admin scope.
CATMASTER_SELF_EVOLUTION_MODE=auto

# Recommended explicit local WebUI settings. The launch script's embedded
# defaults are 0.0.0.0:7991, while the direct Python CLI defaults to
# 127.0.0.1:7860. Source this file with `set -a` so these values are exported.
CATMASTER_PROJECT_SPACE_ROOT=./project_space
CATMASTER_CONDA_ENV=catmaster
CATMASTER_HOST=127.0.0.1
CATMASTER_PORT=7991
# Optional stable cookie namespace. When empty, the listening port is used.
CATMASTER_WEBUI_INSTANCE_ID=
CATMASTER_RUNTIME_DIR=.runtime
CATMASTER_WEBUI_LOG=.runtime/webui.log
CATMASTER_WEBUI_PID=.runtime/webui.pid
